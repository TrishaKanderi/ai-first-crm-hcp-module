# Groq API key - create one at https://console.groq.com/keys
GROQ_API_KEY=

# Primary model used by the agent (fast + cheap, good for tool routing)
GROQ_MODEL=llama-3.1-8b-instant

# Optional heavier model for more complex reasoning steps
GROQ_MODEL_LARGE=llama-3.3-70b-versatile

# Database - defaults to local SQLite for quick setup.
# Postgres example:  postgresql+psycopg2://user:password@localhost:5432/crm_hcp
# MySQL example:      mysql+pymysql://user:password@localhost:3306/crm_hcp
DATABASE_URL=sqlite:///./crm_hcp.db
